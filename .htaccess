DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Luôn lấy bản landing page mới sau khi cập nhật web2
    <IfModule mod_headers.c>
        <FilesMatch "^(index|admin)\.html$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
        </FilesMatch>
    </IfModule>

    # Không cho tải trực tiếp dữ liệu, token và mã nguồn nội bộ
    RewriteRule ^(?:payment_config|telegram_config|orders|licenses|bank_transactions|visits|pixel_stats|coupons|temp_login)\.json$ - [F,L,NC]
    RewriteRule ^(?:server\.py|server\.ps1|api\.php|GoogleAppsScript_CRM_AutoBot\.js)$ - [F,L,NC]

    # Điều hướng /admin sang admin/index.html hoặc admin.html
    RewriteRule ^admin/?$ admin/index.html [L,QSA]

    # Điều hướng toàn bộ /api/* sang api.php
    RewriteRule ^api/(.*)$ api.php [L,QSA]

    # Nếu file hoặc thư mục tồn tại thật thì phục vụ trực tiếp
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>
